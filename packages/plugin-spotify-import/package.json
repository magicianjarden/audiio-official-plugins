{
  "name": "@audiio/plugin-spotify-import",
  "version": "1.0.0",
  "description": "Spotify import plugin for Audiio - import playlists and liked songs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "audiio": {
    "type": "plugin",
    "id": "spotify-import",
    "roles": ["tool"]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@audiio/sdk": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "keywords": ["audiio", "plugin", "spotify", "import", "migration"],
  "author": "Audiio",
  "license": "MIT"
}
