{
  "name": "@audiio/plugin-listenbrainz",
  "version": "1.0.0",
  "description": "ListenBrainz scrobbler for Audiio - track your listening history",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "audiio": {
    "type": "plugin",
    "id": "listenbrainz",
    "roles": ["scrobbler"]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@audiio/sdk": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "keywords": ["audiio", "plugin", "listenbrainz", "scrobbler", "lastfm"],
  "author": "Audiio",
  "license": "MIT"
}
